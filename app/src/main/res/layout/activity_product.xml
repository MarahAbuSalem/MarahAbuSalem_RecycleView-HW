<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    >

    <!-- Top bar: back + search + grid icon -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:layout_marginTop="15dp">

        <ImageView
            android:id="@+id/back_pr"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/grid_pr"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_grid" />

        <EditText
            android:id="@+id/search_pr"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_toEndOf="@+id/back_pr"
            android:layout_toStartOf="@+id/search_btn"
            android:layout_marginStart="10dp"
            android:background="@drawable/ic_search"
            android:hint="Search Product"
            android:paddingStart="12dp"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/search_btn"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_toStartOf="@+id/grid_pr"
            android:layout_marginEnd="10dp"
            android:background="#1E6FD9"
            android:padding="12dp"
            android:src="@drawable/ic_search" />
    </RelativeLayout>

    <!-- Most Popular + Filter -->
    <RelativeLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/top_bar"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="Most Popular"
            android:textColor="#000"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/filter_pr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:drawableEnd="@drawable/ic_filter"
            android:drawablePadding="6dp"
            android:text="Filter"
            android:textColor="#000"
            android:textSize="16sp" />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/title_bar"
        android:background="#F5F5F5"
        android:padding="8dp" />

</RelativeLayout>